diff -ru a/src/interrupt/riscv.rs b/src/interrupt/riscv.rs
--- a/src/interrupt/riscv.rs
+++ b/src/interrupt/riscv.rs
@@ -597,7 +597,14 @@
     #[unsafe(no_mangle)]
     #[crate::ram]
     unsafe fn handle_interrupts(cpu_intr: CpuInterrupt) {
-        let status = InterruptStatus::current();
+        let mut status = InterruptStatus::current();
+        // esp-emu never mirrors sources into INTR_STATUS: like xtensa edge interrupts, call every
+        // handler mapped to this interrupt (each checks its own peripheral)
+        if status.iterator().next().is_none() {
+            for nr in 0..crate::soc::pac::__EXTERNAL_INTERRUPTS.len() as u8 {
+                status.set(nr);
+            }
+        }
 
         // this has no effect on level interrupts, but the interrupt may be an edge one
         // so we clear it anyway
diff -ru a/src/interrupt/software.rs b/src/interrupt/software.rs
--- a/src/interrupt/software.rs
+++ b/src/interrupt/software.rs
@@ -105,7 +105,11 @@
                 crate::interrupt::free(|| {
                     reg.write(|w| w.cpu_intr().set_bit());
                     // Wait for the interrupt to actually take effect.
-                    while !self.is_pending() {}
+                    // esp-emu never mirrors FROM_CPU_INTR into INTR_STATUS: bounded wait
+                    let mut spins = 0u32;
+                    while !self.is_pending() && spins < 1000 {
+                        spins += 1;
+                    }
                 });
             }
         }
